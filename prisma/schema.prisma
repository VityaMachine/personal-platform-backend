generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PAUSED
  POSTPONED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskActionType {
  CREATED
  EDITED
  STATUS_CHANGED
  ARCHIVED
  UNARCHIVED
  DELETED
  SUBTASK_CREATED
  SUBTASK_EDITED
  SUBTASK_STATUS_CHANGED
  SUBTASK_DELETED
  AREA_CHANGED
}

model Task {
  id                       String     @id @default(uuid()) @db.Uuid
  title                    String     @db.VarChar(160)
  description              String?    @db.Text
  status                   TaskStatus @default(TODO)
  priority                 TaskPriority @default(MEDIUM)
  plannedAt                DateTime?  @db.Timestamptz(3)
  dueAt                    DateTime?  @db.Timestamptz(3)
  estimatedDurationMinutes Int
  cancellationNote         String?    @db.Text
  archivedAt               DateTime?  @db.Timestamptz(3)
  deletedAt                DateTime?  @db.Timestamptz(3)
  createdAt                DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime   @updatedAt @db.Timestamptz(3)
  actions                  TaskAction[]
  subtasks                 Subtask[]
  areaId                   String?    @db.Uuid
  area                     Area?      @relation(fields: [areaId], references: [id], onDelete: Restrict)
  routineOccurrenceId      String?    @unique @db.Uuid
  routineOccurrence        RoutineOccurrence? @relation(fields: [routineOccurrenceId], references: [id], onDelete: Restrict)

  @@index([deletedAt, archivedAt, createdAt])
  @@index([areaId])
}

model Area {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(80)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  tasks      Task[]
  routines   Routine[]
}

enum RoutineActionType {
  CREATED
  UPDATED
  PAUSED
  RESUMED
  DELETED
}

model Routine {
  id                       String       @id @default(uuid()) @db.Uuid
  title                    String       @db.VarChar(160)
  description              String?      @db.Text
  priority                 TaskPriority @default(MEDIUM)
  areaId                   String?      @db.Uuid
  estimatedDurationMinutes Int
  timezone                 String       @db.VarChar(100)
  startDate                String       @db.VarChar(10)
  schedule                 Json
  endCondition             Json
  pausedAt                 DateTime?    @db.Timestamptz(3)
  deletedAt                DateTime?    @db.Timestamptz(3)
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime     @updatedAt @db.Timestamptz(3)
  area                     Area?        @relation(fields: [areaId], references: [id], onDelete: Restrict)
  subtasks                 RoutineSubtask[]
  actions                  RoutineAction[]
  occurrences              RoutineOccurrence[]

  @@index([deletedAt, createdAt(sort: Desc), id])
  @@index([areaId])
}

model RoutineOccurrence {
  id            String   @id @default(uuid()) @db.Uuid
  routineId     String   @db.Uuid
  occurrenceKey String
  startDate     String   @db.VarChar(10)
  endDate       String   @db.VarChar(10)
  timezone      String   @db.VarChar(100)
  localTime     String?  @db.VarChar(5)
  instant       DateTime? @db.Timestamptz(3)
  snapshot      Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  routine       Routine  @relation(fields: [routineId], references: [id], onDelete: Restrict)
  task          Task?
  occurrenceNumber Int?
  previousOccurrenceId String? @unique @db.Uuid
  basisCompletedAt DateTime? @db.Timestamptz(3)
  previousOccurrence RoutineOccurrence? @relation("CompletionChain", fields: [previousOccurrenceId], references: [id], onDelete: Restrict)
  nextOccurrence RoutineOccurrence? @relation("CompletionChain")

  @@unique([routineId, occurrenceKey])
  @@unique([routineId, occurrenceNumber])
}

model RoutineSubtask {
  id                       String  @id @default(uuid()) @db.Uuid
  routineId                String  @db.Uuid
  title                    String  @db.VarChar(160)
  estimatedDurationMinutes Int
  position                 Int
  routine                  Routine @relation(fields: [routineId], references: [id], onDelete: Restrict)

  @@unique([routineId, position])
}

model RoutineAction {
  id        String            @id @default(uuid()) @db.Uuid
  routineId String            @db.Uuid
  type      RoutineActionType
  timestamp DateTime          @default(now()) @db.Timestamptz(3)
  metadata  Json
  routine   Routine           @relation(fields: [routineId], references: [id], onDelete: Restrict)

  @@index([routineId, timestamp, id])
}

model Subtask {
  id                       String     @id @default(uuid()) @db.Uuid
  taskId                   String     @db.Uuid
  title                    String     @db.VarChar(160)
  status                   TaskStatus @default(TODO)
  estimatedDurationMinutes Int
  cancellationNote         String?    @db.Text
  createdAt                DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?  @db.Timestamptz(3)
  task                     Task       @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, deletedAt, createdAt])
}

model TaskAction {
  id        String         @id @default(uuid()) @db.Uuid
  taskId    String         @db.Uuid
  type      TaskActionType
  timestamp DateTime       @default(now()) @db.Timestamptz(3)
  metadata  Json
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, timestamp])
}
