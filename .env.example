PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Supabase: copy connection strings from Dashboard > Connect.
# Runtime: Supavisor session pooler (port 5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Prisma CLI / migrations: direct connection (requires IPv6 or IPv4 add-on).
# On IPv4-only networks, use the session pooler URL (port 5432) instead.
DIRECT_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
